<IfModule mod_rewrite.c>
  RewriteEngine On

  # Deny access to the vendor directory
  RewriteRule ^vendor/ - [F,L]

  # Deny access to specific files
  RewriteRule ^sendmail/(bootstrap\.php|config\.php|functions\.php|captcha\.PNG|XFILES\.TTF|constants\.php)$ - [F,L]

  # Deny access to the .env file in the root directory
  RewriteRule ^\.env$ - [F,L]

  # Deny access to any file starting with errorlog and ending with .txt
  RewriteRule ^errorlog.*\.txt$ - [F,L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType font/woff "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 month"
  ExpiresByType application/font-woff "access plus 1 month"
  ExpiresByType application/font-woff2 "access plus 1 month"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 month"
  ExpiresByType application/x-font-ttf "access plus 1 month"
  ExpiresByType application/x-font-opentype "access plus 1 month"
  ExpiresByType font/ttf "access plus 1 month"
  ExpiresByType font/otf "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>

  Header always set Content-Security-Policy "frame-ancestors 'self' https://*.mihai-andrei-neacsu.de"
</IfModule>


<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block AI crawlers / LLM training scrapers (403)
  RewriteCond %{HTTP_USER_AGENT} "(GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-User|Claude-SearchBot|Claude-Web|anthropic-ai|Google-CloudVertexBot|GoogleOther|PerplexityBot|Perplexity-User|CCBot|Bytespider|ByteSpider|Amazonbot|meta-externalagent|meta-externalfetcher|FacebookBot|cohere-ai|cohere-training-data-crawler|MistralAI-User|Diffbot|omgili|omgilibot|ImagesiftBot|YouBot|AI2Bot|Ai2Bot-Dolma|Timpibot|PanguBot|Kangaroo Bot|Webzio-Extended|DataForSeoBot|SemrushBot-OCOB|Firecrawl|FirecrawlAgent|ProRataInc|TikTokSpider|Applebot-Extended)" [NC]
  RewriteRule ^ - [F,L]

  # Deny access to the vendor directory
</IfModule>
